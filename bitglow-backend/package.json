{
  "name": "bitglow-backend",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:open-dm": "node -e \"process.env.NODE_ENV='test'; require('child_process').execSync('npx tsx scripts/testOpenDMPolicy.ts', { stdio: 'inherit', env: { ...process.env, NODE_ENV: 'test' } });\"",
    "test:privacy-toggle": "tsx scripts/testPrivacyToggle.ts",
    "test:relationships": "tsx scripts/testPrivateAccountRelationships.ts",
    "test:identity": "node -e \"process.env.NODE_ENV='test'; require('child_process').execSync('npx tsx scripts/testIdentityFoundation.ts', { stdio: 'inherit', env: { ...process.env, NODE_ENV: 'test' } });\"",
    "test:cors": "tsx scripts/testCorsAndSignup.ts",
    "start": "node dist/src/server.js",
    "audit:live-messages": "tsx scripts/audit-live-messages.ts",
    "audit:security": "tsx scripts/audit-security.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@sentry/node": "^10.59.0",
    "@supabase/supabase-js": "^2.110.8",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.9.0",
    "fastify-plugin": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.17.2",
    "resend": "^6.18.0",
    "sanitize-html": "^2.17.3",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "ws": "^8.18.0"
  }
}
