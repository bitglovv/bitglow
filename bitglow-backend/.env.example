# Required
DATABASE_URL=postgresql://username:password@localhost:5432/bitglow
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# URLs
APP_URL=http://localhost:5173

# Email (Resend)
RESEND_API_KEY=RESEND_API_KEY
FROM_EMAIL=BitGlow <onboarding@resend.dev>


# Optional
PORT=3003
HOST=0.0.0.0
TRUST_PROXY=false
LOG_SECURITY_EVENTS=true
JWT_ISSUER=bitglow-backend
JWT_AUDIENCE=bitglow-api
# Access token lifetime in seconds. Default: 900 (15 minutes).
# Increase only if you have a clear need — long-lived access tokens increase hijack risk.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
DB_STATEMENT_TIMEOUT_MS=15000
DB_CONNECTION_TIMEOUT_MS=10000
LIVE_MESSAGE_TTL_SECONDS=300
WS_MAX_PAYLOAD_BYTES=16384

# PostgreSQL TLS: Set to "false" only when your DB provider uses a self-signed cert
# (e.g. local dev against a docker container). Leave unset in production to enforce
# certificate validation automatically.
# DB_SSL_REJECT_UNAUTHORIZED=false

# Supabase (required for avatar uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key