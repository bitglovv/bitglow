# Required
DATABASE_URL=postgresql://username:password@localhost:5432/bitglow
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# URLs
APP_URL=http://localhost:5173

# Email (Resend)
RESEND_API_KEY=RESEND_API_KEY
FROM_EMAIL=BitGlow <onboarding@resend.dev>


# Optional
PORT=3003
HOST=0.0.0.0
TRUST_PROXY=false
LOG_SECURITY_EVENTS=true
JWT_ISSUER=bitglow-backend
JWT_AUDIENCE=bitglow-api
# Access token lifetime in seconds. Default: 900 (15 minutes).
# Increase only if you have a clear need — long-lived access tokens increase hijack risk.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
DB_STATEMENT_TIMEOUT_MS=15000
DB_CONNECTION_TIMEOUT_MS=10000
LIVE_MESSAGE_TTL_SECONDS=300
WS_MAX_PAYLOAD_BYTES=16384

# ── PostgreSQL TLS ────────────────────────────────────────────────────────────
#
# DB_SSL_REJECT_UNAUTHORIZED
#   Controls whether the PostgreSQL TLS certificate chain is verified.
#   Default (unset): true in production, false in development.
#   Set to "false" ONLY for local dev against a self-signed DB (e.g. Docker).
#   Never set to "false" in production — it disables all TLS authentication.
#
# DB_SSL_CA_BASE64
#   Base64-encoded PEM CA certificate used to verify the database server's TLS
#   certificate chain. Required in production when the database uses a CA that
#   is NOT in Node's built-in Mozilla root store.
#
#   Supabase and Amazon RDS use their own root CAs which are NOT trusted by
#   Node by default. Without this variable, production connections will fail with:
#     SELF_SIGNED_CERT_IN_CHAIN
#
#   How to obtain the Supabase CA certificate:
#     1. Go to: https://supabase.com/dashboard/project/<your-ref>/settings/database
#     2. Scroll to "SSL Certificate" and click "Download certificate"
#        (downloads a file usually named "prod-ca-2021.crt" or similar)
#     3. Base64-encode it (single line, no wrapping):
#          Linux/macOS: base64 -w 0 prod-ca-2021.crt
#          macOS alt:   base64 -i prod-ca-2021.crt | tr -d '\n'
#          Windows PS:  [Convert]::ToBase64String([IO.File]::ReadAllBytes('prod-ca-2021.crt'))
#     4. Paste the result as the value of DB_SSL_CA_BASE64 in your Render env vars.
#
#   How to configure on Render:
#     Dashboard → Your service → Environment → Add environment variable
#       Key:   DB_SSL_CA_BASE64
#       Value: <paste the base64 string>
#     Do NOT wrap the value in quotes. Do NOT add newlines.
#
# Development (local Postgres / Docker — no CA needed):
# DB_SSL_REJECT_UNAUTHORIZED=false
#
# Production (Supabase — CA cert required):
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_BASE64=<base64-encoded PEM from Supabase dashboard>

# Supabase (required for avatar uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key