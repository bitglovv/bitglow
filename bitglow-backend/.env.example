# Required
DATABASE_URL=postgresql://username:password@localhost:5432/bitglow
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# URLs
APP_URL=http://localhost:5173

# Email (Resend)
RESEND_API_KEY=RESEND_API_KEY
FROM_EMAIL=BitGlow <onboarding@resend.dev>

# Email (Brevo SMTP - signup verification)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@smtp-brevo.com
SMTP_PASS=YOUR_SMTP_PASSWORD

# Optional
PORT=3003
HOST=0.0.0.0
TRUST_PROXY=false
LOG_SECURITY_EVENTS=true
JWT_ISSUER=bitglow-backend
JWT_AUDIENCE=bitglow-api
ACCESS_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_TTL_SECONDS=2592000
DB_STATEMENT_TIMEOUT_MS=15000
DB_CONNECTION_TIMEOUT_MS=10000
LIVE_MESSAGE_TTL_SECONDS=300
WS_MAX_PAYLOAD_BYTES=16384